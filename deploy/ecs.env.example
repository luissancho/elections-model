# Configuración del lanzador deploy/ecs/job.py (copiar a deploy/ecs.env, que git ignora).
# Perfil y credenciales de AWS: la cadena normal de boto3 (AWS_PROFILE en el shell).

# Clúster de ECS donde corre el servicio web.
ECS_CLUSTER=elections-model-cluster
# Servicio web del que se toman la red y la definición de tarea.
ECS_SERVICE=elections-model-service
# Familia de la definición de tarea de los jobs (la crea --register).
ECS_TASK_FAMILY=elections-model-job
# Región de AWS.
AWS_REGION=eu-west-1
# Grupo de logs de CloudWatch.
ECS_LOG_GROUP=/ecs/elections-model

# Vacías: se usa la red del despliegue actual del servicio. Rellenar para sobrescribirla.
# Subredes separadas por comas.
ECS_SUBNETS=
# Grupos de seguridad separados por comas.
ECS_SECURITY_GROUPS=
# ENABLED o DISABLED.
ECS_PUBLIC_IP=
