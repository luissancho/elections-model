{
  "family": "elections-model-job",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "2048",
  "memory": "4096",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "taskRoleArn": "<task-role>",
  "executionRoleArn": "<execution-role>",
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "<account>.dkr.ecr.<region>.amazonaws.com/elections-model:latest",
      "essential": true,
      "environment": [
        {
          "name": "RUN_JOB",
          "value": ""
        }
      ],
      "environmentFiles": [
        {
          "value": "arn:aws:s3:::<bucket>/elections.env",
          "type": "s3"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/elections-model",
          "awslogs-region": "<region>",
          "awslogs-stream-prefix": "job"
        }
      }
    }
  ]
}
