{
  "cluster": "elections-model-cluster",
  "taskDefinition": "elections-model-job",
  "launchType": "FARGATE",
  "count": 1,
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": [
        "<subnet-id>",
        "<subnet-id>",
        "<subnet-id>"
      ],
      "securityGroups": [
        "<security-group-id>"
      ],
      "assignPublicIp": "ENABLED"
    }
  },
  "overrides": {
    "containerOverrides": [
      {
        "name": "Main",
        "environment": [
          {
            "name": "RUN_JOB",
            "value": "publish {\"what\":[\"forecast\",\"analysis\"],\"scopes\":[\"es\"],\"n_sim\":10000}"
          }
        ]
      }
    ]
  }
}
