# Docker anchors patterns at the context root: these keep credentials, key material and git history out of the image
.git
**/*.env
**/env.*
**/*.key
**/*.crt
**/*.pem

# To prevent storing dev/temporary container data
*.csv

# Input data must ship with the image
!data/**
/tmp/*
